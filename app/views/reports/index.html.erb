<% total_attention = @attention.sum { |report| @counts[report.key].to_i } %>
<% categories = @grouped.reject { |_label, reports| reports.empty? } %>

<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Reports</h1>
    <div class="text-13 text-secondary mt-1">
      <span class="text-body"><%= Reports::Catalog.reports.size %></span> reports ·
      <span class="<%= total_attention.positive? ? 'text-warning' : 'text-secondary' %>"><%= total_attention %></span> need attention
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Charts", reports_charts_path, class: "btn btn-outline-secondary btn-sm" %>
    <button class="btn btn-outline-secondary btn-sm d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#reportsNavMobile">
      Categories
    </button>
  </div>
</div>

<button class="form-control text-start text-secondary mb-3" data-bs-toggle="modal" data-bs-target="#reportsSearch">
  <i class="bi bi-search me-1"></i> Search all reports...
  <kbd class="float-end small">Cmd+K</kbd>
</button>

<% nav_markup = capture do %>
  <% if @attention.any? %>
    <a href="#" class="settings-nav-item attention" data-reports-category="needs_attention">
      <span>Needs attention</span>
      <span class="count"><%= total_attention %></span>
    </a>
  <% end %>
  <a href="#" class="settings-nav-item active" data-reports-category="all">
    <span>All reports</span>
    <span class="count"><%= Reports::Catalog.reports.size %></span>
  </a>
  <div class="settings-nav-divider"></div>
  <% categories.each do |label, reports| %>
    <a href="#" class="settings-nav-item" data-reports-category="<%= label.parameterize %>">
      <span><%= label %></span>
      <span class="count"><%= reports.size %></span>
    </a>
  <% end %>
  <div class="settings-nav-divider"></div>
  <%= link_to reports_charts_path, class: "settings-nav-item" do %>
    <span>Charts</span>
    <span class="count"><i class="bi bi-graph-up"></i></span>
  <% end %>
<% end %>

<div class="offcanvas offcanvas-start" tabindex="-1" id="reportsNavMobile" aria-labelledby="reportsNavMobileLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="reportsNavMobileLabel">Report categories</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <nav class="settings-nav"><%= nav_markup %></nav>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-3 d-none d-md-block">
    <nav class="settings-nav" style="position: sticky; top: 1rem;">
      <%= nav_markup %>
    </nav>
  </div>
  <div class="col-md-9">
    <% if @attention.any? %>
      <section class="d-none" data-reports-section="needs_attention">
        <h2 class="h-section-label mb-2">Needs attention</h2>
        <div class="list-group list-compact mb-3">
          <%= render partial: 'report_link', collection: @attention, as: :report,
                     locals: { counts: @counts, highlight: true } %>
        </div>
      </section>
    <% end %>

    <% categories.each do |label, reports| %>
      <section data-reports-section="<%= label.parameterize %>">
        <h2 class="h-section-label mb-2"><%= label %></h2>
        <div class="list-group list-compact mb-3">
          <%= render partial: 'report_link', collection: reports, as: :report,
                     locals: { counts: @counts, highlight: false } %>
        </div>
      </section>
    <% end %>
  </div>
</div>

<div class="modal fade" id="reportsSearch" tabindex="-1" aria-labelledby="reportsSearchLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="reportsSearchLabel">Search reports</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <input type="search" class="form-control form-control-sm mb-3" id="reportsSearchInput" placeholder="Type a report name or what it shows..." autocomplete="off">
        <div class="list-group list-compact" id="reportsSearchResults">
          <% Reports::Catalog.reports.each do |report| %>
            <%= link_to report_path(report), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center",
                        data: { reports_search_result: true, title: report.title.downcase, description: report.description.downcase } do %>
              <span>
                <div class="item-title"><%= report.title %></div>
                <div class="item-desc"><%= Reports::Catalog::CATEGORIES[report.category] %> · <%= report.description %></div>
              </span>
              <span class="text-secondary text-12 num"><%= @counts[report.key] %></span>
            <% end %>
          <% end %>
        </div>
        <div class="text-center text-secondary py-5 d-none" id="reportsSearchEmpty">
          <div class="text-13 mb-1">No results</div>
          <div class="text-12">Try a different member, payment, or Slack term</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initReportsIndex() {
      var navItems = document.querySelectorAll('[data-reports-category]');
      var sections = document.querySelectorAll('[data-reports-section]');
      var searchInput = document.getElementById('reportsSearchInput');
      var searchResults = document.querySelectorAll('[data-reports-search-result]');
      var searchEmpty = document.getElementById('reportsSearchEmpty');
      var searchModal = document.getElementById('reportsSearch');

      function showCategory(category) {
        navItems.forEach(function(item) {
          item.classList.toggle('active', item.getAttribute('data-reports-category') === category);
        });
        sections.forEach(function(section) {
          var sectionCategory = section.getAttribute('data-reports-section');
          var isAttention = sectionCategory === 'needs_attention';
          var visible = category === 'all' ? !isAttention : sectionCategory === category;
          section.classList.toggle('d-none', !visible);
        });
      }

      navItems.forEach(function(item) {
        item.addEventListener('click', function(event) {
          event.preventDefault();
          showCategory(item.getAttribute('data-reports-category'));
          var openOffcanvas = document.querySelector('.offcanvas.show');
          if (openOffcanvas && window.bootstrap) {
            window.bootstrap.Offcanvas.getInstance(openOffcanvas).hide();
          }
        });
      });

      function filterSearch() {
        var query = (searchInput.value || '').trim().toLowerCase();
        var visible = 0;
        searchResults.forEach(function(result) {
          var haystack = result.getAttribute('data-title') + ' ' + result.getAttribute('data-description');
          var matches = query.length === 0 || haystack.indexOf(query) !== -1;
          result.classList.toggle('d-none', !matches);
          if (matches) visible += 1;
        });
        if (searchEmpty) searchEmpty.classList.toggle('d-none', visible !== 0);
      }

      if (searchInput) searchInput.addEventListener('input', filterSearch);

      document.addEventListener('keydown', function(event) {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k' && searchModal && window.bootstrap) {
          event.preventDefault();
          window.bootstrap.Modal.getOrCreateInstance(searchModal).show();
          setTimeout(function() { if (searchInput) searchInput.focus(); }, 150);
        }
      });
    }

    document.addEventListener('DOMContentLoaded', initReportsIndex);
    document.addEventListener('turbo:load', initReportsIndex);
  })();
</script>
