<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Membership Settings</h1>
    <div class="text-13 text-secondary mt-1">Timing and grace periods for payments, access, applications, and reminders.</div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_membership_settings_path, class: "btn btn-primary btn-sm" %>
    <%= link_to "Back to Settings", settings_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <%= render "setting_group", title: "Payments" do %>
      <%= render "show_field",
          label: "Payment grace period",
          value: safe_join([content_tag(:strong, @membership_setting.payment_grace_period_days), " days"]),
          help: "Days after payment due date before membership is marked as lapsed." %>
      <%= render "show_field",
          label: "Manual payment “due soon” window",
          value: safe_join([content_tag(:strong, @membership_setting.manual_payment_due_soon_days), " ",
                            "day".pluralize(@membership_setting.manual_payment_due_soon_days)]),
          help: "Admin dashboard and manual payments list treat dues as “due soon” when the next due date is today, overdue, or within this many calendar days." %>
      <%= render "show_field",
          label: "Reactivation grace period",
          value: safe_join([content_tag(:strong, @membership_setting.reactivation_grace_period_months), " months"]),
          help: "Months a lapsed member can reactivate without needing to reapply." %>
    <% end %>

    <%= render "setting_group", title: "Login / invitations" do %>
      <%= render "show_field",
          label: "Invitation expiry",
          value: invitation_expiry_display(@membership_setting),
          help: "How long invitation links remain valid before they expire." %>
      <%= render "show_field",
          label: "Member login link expiry",
          value: login_link_expiry_display(@membership_setting),
          help: "How long member login links remain valid before they expire." %>
      <%= render "show_field",
          label: "Admin login link expiry",
          value: safe_join([content_tag(:strong, @membership_setting.admin_login_link_expiry_minutes), " minutes"]),
          help: "How long admin login links remain valid (shorter for security)." %>
    <% end %>

    <%= render "setting_group", title: "Applications" do %>
      <%= render "show_field",
          label: "Application email verification expiry",
          value: application_verification_expiry_display(@membership_setting),
          help: "How long application email verification links remain valid." %>
      <%= render "show_field",
          label: "Application review time cap",
          value: safe_join([content_tag(:strong, @membership_setting.application_review_time_cap_days), " ",
                            "day".pluralize(@membership_setting.application_review_time_cap_days)]),
          help: "Maximum review time shown to applicants on the status page. Admins still see the actual average." %>
    <% end %>

    <%= render "setting_group", title: "Reminders", context: link_to("Reminders settings", reminder_settings_path, class: "text-secondary") do %>
      <%= render "show_field",
          label: "Slack signup reminder — initial delay",
          value: safe_join([content_tag(:strong, @membership_setting.slack_signup_reminder_initial_delay_days), " ",
                            "day".pluralize(@membership_setting.slack_signup_reminder_initial_delay_days)]),
          help: "Days after approval before the first Slack signup reminder." %>
      <%= render "show_field",
          label: "Slack signup reminder — repeat interval",
          value: safe_join([content_tag(:strong, @membership_setting.slack_signup_reminder_repeat_delay_days), " ",
                            "day".pluralize(@membership_setting.slack_signup_reminder_repeat_delay_days)]),
          help: "Minimum days between Slack signup reminders for the same member." %>
      <%= render "show_field",
          label: "Slack signup reminder — account age limit",
          value: safe_join([content_tag(:strong, @membership_setting.slack_signup_reminder_max_account_age_months), " ",
                            "month".pluralize(@membership_setting.slack_signup_reminder_max_account_age_months)]),
          help: "Only members who joined within this window are nudged to join Slack." %>
      <%= render "show_field",
          label: "Application link reminder — delay",
          value: safe_join([content_tag(:strong, @membership_setting.application_link_reminder_delay_days), " ",
                            "day".pluralize(@membership_setting.application_link_reminder_delay_days)]),
          help: "Days after sending an application link before the first reminder, and between subsequent reminders." %>
      <%= render "show_field",
          label: "Application link reminder — maximum",
          value: content_tag(:strong, @membership_setting.application_link_reminder_max_count),
          help: "Stop after this many reminders or when the link expires, whichever comes first." %>
    <% end %>
  </div>

  <div class="col-lg-4">
    <%= render "about_sidebar" %>
  </div>
</div>
