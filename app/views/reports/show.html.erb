<div class="row g-3">
  <div class="col-md-3 d-none d-md-block">
    <%= render 'report_sidebar', counts: @counts, current_key: @report.key %>
  </div>

  <div class="col-md-9">
    <div class="d-flex align-items-end justify-content-between mb-3">
      <div>
        <div class="text-12 text-secondary">
          <%= link_to "Reports", reports_path, class: "text-decoration-none" %> ·
          <%= Reports::Catalog::CATEGORIES[@report.category] %>
        </div>
        <h1 class="h-page-title mb-0"><%= @report.title %></h1>
        <div class="text-13 text-secondary mt-1">
          <span class="<%= @pagy.count.zero? ? 'text-secondary' : 'text-body' %>"><%= @pagy.count %></span>
          <%= 'record'.pluralize(@pagy.count) %> · <%= @report.description %>
        </div>
      </div>
      <button class="btn btn-outline-secondary btn-sm d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#reportNavMobile">
        Reports
      </button>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <% if @rows.any? %>
          <%= render partial: @report.partial, locals: @locals.merge(rows: @rows, report: @report) %>
        <% else %>
          <p class="text-muted mb-0 p-3"><%= @report.empty_message %></p>
        <% end %>
      </div>
    </div>

    <% if @rows.any? %>
      <%= render 'shared/pagination', pagy: @pagy %>
    <% end %>
  </div>
</div>

<div class="offcanvas offcanvas-start" tabindex="-1" id="reportNavMobile" aria-labelledby="reportNavMobileLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="reportNavMobileLabel">Reports</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <%= render 'report_sidebar', counts: @counts, current_key: @report.key %>
  </div>
</div>
