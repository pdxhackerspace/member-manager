<div class="d-flex flex-wrap gap-2 mb-2">
  <button type="button" class="btn btn-sm btn-outline-secondary quick-expire"
          data-action="quick-expire#set" data-quick-expire-days-param="1">1 day</button>
  <button type="button" class="btn btn-sm btn-outline-secondary quick-expire"
          data-action="quick-expire#set" data-quick-expire-days-param="3">3 days</button>
  <button type="button" class="btn btn-sm btn-outline-secondary quick-expire"
          data-action="quick-expire#set" data-quick-expire-days-param="7">1 week</button>
  <button type="button" class="btn btn-sm btn-outline-secondary quick-expire"
          data-action="quick-expire#set" data-quick-expire-days-param="14">2 weeks</button>
</div>
