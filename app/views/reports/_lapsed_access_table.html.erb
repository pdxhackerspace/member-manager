<%# Lapsed members who badged in after their last payment.
    metadata: user_id => { last_payment_date:, access_count:, most_recent_at: }
    recent_accesses: user_id => [AccessLog, ...] %>
<div class="table-responsive">
  <table class="table table-compact mb-0 align-middle">
    <thead>
      <tr>
        <th scope="col" style="width: 48px;"></th>
        <th scope="col">Member</th>
        <th scope="col">Last payment</th>
        <th scope="col" class="num">Accesses since</th>
        <th scope="col">Most recent access</th>
        <th scope="col">Recent access details</th>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |user| %>
        <% entry = metadata[user.id] || {} %>
        <tr>
          <td>
            <%= link_to user_path(user) do %>
              <%= render 'shared/user_avatar', user: user %>
            <% end %>
          </td>
          <td>
            <%= link_to user.display_name, user_path(user), class: "text-decoration-none fw-medium" %>
            <% if user.email.present? %>
              <div class="text-12 text-secondary"><%= user.email %></div>
            <% end %>
          </td>
          <td>
            <% if entry[:last_payment_date] %>
              <%= l(entry[:last_payment_date], format: :long) %>
              <div class="text-12 text-secondary"><%= time_ago_in_words(entry[:last_payment_date]) %> ago</div>
            <% else %>
              <span class="text-secondary">—</span>
            <% end %>
          </td>
          <td class="num fw-medium"><%= entry[:access_count] %></td>
          <td>
            <% if entry[:most_recent_at] %>
              <%= entry[:most_recent_at].strftime('%b %d, %Y %H:%M') %>
            <% else %>
              <span class="text-secondary">—</span>
            <% end %>
          </td>
          <td>
            <% (recent_accesses[user.id] || []).each do |access| %>
              <div class="text-12">
                <span class="text-secondary"><%= access.logged_at.strftime('%b %d, %Y %H:%M') %></span>
                <% if access.location.present? %>
                  <span class="text-secondary ms-1">(<%= access.location %>)</span>
                <% end %>
              </div>
            <% end %>
            <% shown = (recent_accesses[user.id] || []).size %>
            <% if entry[:access_count].to_i > shown %>
              <div class="text-12 text-secondary fst-italic">… and <%= entry[:access_count] - shown %> more</div>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
