<div class="mb-4">
  <%= link_to "&larr; Back to Reports".html_safe, reports_path, class: "text-decoration-none" %>
</div>

<div class="card shadow-sm border-0">
  <div class="card-header bg-body-tertiary">
    <h2 class="h5 mb-0"><%= @title %> (<%= @active_no_slack_count %>)</h2>
  </div>
  <div class="card-body">
    <% if @active_no_slack.any? %>
      <p class="text-muted small mb-3">Active members with no Slack account linked to their profile.</p>
      <%= render partial: 'active_no_slack_table', locals: { users: @active_no_slack } %>
    <% else %>
      <p class="text-muted mb-0">Every active member has a linked Slack account.</p>
    <% end %>
  </div>
</div>
