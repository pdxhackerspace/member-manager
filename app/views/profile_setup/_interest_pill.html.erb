<span id="<%= dom_id(interest, :pill) %>"
      data-live-filter-target="item"
      data-search-text="<%= interest.name %>"
      data-live-filter-keep-visible="<%= selected ? 'true' : 'false' %>">
  <% if selected %>
    <%= button_to profile_setup_remove_interest_path(interest),
        method: :delete,
        class: 'btn btn-primary btn-sm rounded-pill' do %>
      <i class="bi bi-check me-1"></i><%= interest.name %>
      <i class="bi bi-x ms-1"></i>
    <% end %>
  <% else %>
    <%= button_to profile_setup_add_interest_path(interest),
        method: :post,
        class: 'btn btn-outline-secondary btn-sm rounded-pill' do %>
      <%= interest.name %>
    <% end %>
  <% end %>
</span>
